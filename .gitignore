# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.trae/

# WorkBuddy specific (not needed for other platforms)
.workbuddy/

# Temp files
*.tmp
*.log

# Installer / binary files (not part of the project)
*.exe
*.7z
*.zip

# Data buffer - user input data (privacy protection)
data-buffer/input/*
!data-buffer/input/.gitkeep

# Output area - task results (may contain masked data)
output/*
!output/.gitkeep

# Commit message temp file
COMMIT_MSG.txt
